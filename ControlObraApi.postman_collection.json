				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"// Guardar automáticamente el token JWT",
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    pm.collectionVariables.set(\"token\", jsonData.token);",
									"    console.log(\"✅ Token guardado automáticamente\");",
									"} else {",
									"    console.log(\"❌ Login falló, token no guardado\");",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"demo@test.com\",\n  \"password\": \"Pass123!\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{url}}/Auth/login",
							"host": [
								"{{url}}"
							],
							"path": [
								"Auth",
								"login"
							]
						},
						"description": "Autentica un usuario y genera un token JWT válido por 24 horas. El token se guarda automáticamente en la variable {{token}}."
					},
